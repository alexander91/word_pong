# Copy to .env for a manual run. The Translator emulator sets all of these itself.

# Translator public API base (mp-runtime fetches each player's cards from here).
TRANSLATOR_API_BASE=http://localhost:4106

# Gameplay socket port. Assigned in memdecks_data/ports.json.
PORT=4006

# Allowed browser origins for the gameplay socket (comma-separated).
CLIENT_ORIGINS=http://localhost:5178

# Match-ticket verification — set ONE of these:
#  - Production: verify platform-signed (RS/ES) tickets against the platform JWKS.
# MATCH_JWKS_URL=https://<platform>/.well-known/jwks.json
#  - Dev / Translator emulator: shared HS256 secret ('emulator-dev-secret' by default).
MATCH_TICKET_SECRET=emulator-dev-secret
